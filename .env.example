# Required core databases (local defaults shown; use distinct databases)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/gamblr
ML_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/gamblr_ml
SQL_ECHO=false
# Alembic can target a different database explicitly; otherwise DATABASE_URL is used.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/gamblr

# Browser origins allowed to call FastAPI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional paid integrations. Leave blank for schedule/statistics/prediction development.
THEODDS_API_KEY=
THEODDS_BASE_URL=https://api.the-odds-api.com/v4
SPORTSDATA_API_KEY=
SPORTSDATA_BASE_URL=https://api.sportsdata.io/v3/nba
PROPLINE_API_KEY=
PROPLINE_BASE_URL=https://api.prop-line.com/v1

# Optional prediction tuning
PRED_HISTORY_WINDOW_DAYS=1600
PRED_TEAM_STATS_WINDOW_DAYS=1200
